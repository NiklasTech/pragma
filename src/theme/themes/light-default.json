{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",
  "metadata": {
    "id": "light-default",
    "name": "Pragma Light",
    "author": "Pragma Team",
    "description": "Warm paper ground with raised white wells; a deep Pragma orange marks what needs you.",
    "version": "2.0.0",
    "license": "MIT"
  },
  "appearance": {
    "defaultMode": "light",
    "supportedModes": ["light"]
  },
  "tokens": {
    "colors": {
      "background": {
        "chrome": "#e9e7e1",
        "root": "#fbfaf7",
        "surface": "#f3f1ec",
        "elevated": "#ffffff",
        "input": "#ffffff",
        "hover": "rgba(0, 0, 0, 0.05)",
        "active": "rgba(0, 0, 0, 0.07)",
        "overlay": "rgba(28, 27, 25, 0.35)"
      },
      "foreground": {
        "default": "#1c1b19",
        "muted": "#57544e",
        "subtle": "#67645e",
        "inverse": "#ffffff"
      },
      "accent": {
        "default": "#b23c0a",
        "subtle": "rgba(255, 122, 61, 0.16)",
        "glow": "rgba(255, 122, 61, 0.3)"
      },
      "border": {
        "default": "rgba(0, 0, 0, 0.1)",
        "subtle": "rgba(0, 0, 0, 0.07)",
        "focus": "rgba(178, 60, 10, 0.55)"
      },
      "status": {
        "success": "#27702b",
        "successBg": "rgba(63, 154, 69, 0.12)",
        "warning": "#8f5a00",
        "warningBg": "rgba(143, 90, 0, 0.1)",
        "error": "#b3261e",
        "errorBg": "rgba(179, 38, 30, 0.1)",
        "info": "#2b5fb4",
        "infoBg": "rgba(43, 95, 180, 0.1)"
      },
      "git": {
        "added": "{colors.status.success}",
        "addedBg": "{colors.status.successBg}",
        "modified": "{colors.status.warning}",
        "modifiedBg": "{colors.status.warningBg}",
        "deleted": "{colors.status.error}",
        "deletedBg": "{colors.status.errorBg}",
        "untracked": "{colors.status.info}",
        "untrackedBg": "{colors.status.infoBg}",
        "ignored": "{colors.foreground.subtle}",
        "conflict": "#6b4fd1"
      },
      "thread": {
        "default": "{colors.accent.subtle}",
        "active": "{colors.accent.default}"
      },
      "selection": "rgba(43, 95, 180, 0.16)",
      "scrollbar": {
        "track": "transparent",
        "thumb": "rgba(0, 0, 0, 0.14)",
        "thumbHover": "rgba(0, 0, 0, 0.24)"
      }
    },
    "editor": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "selection": "{colors.selection}",
      "cursor": "{colors.accent.default}",
      "gutter": {
        "background": "{colors.background.root}",
        "foreground": "{colors.foreground.subtle}",
        "activeBackground": "{colors.background.surface}"
      },
      "line": {
        "active": "rgba(0, 0, 0, 0.035)",
        "highlight": "rgba(43, 95, 180, 0.06)"
      },
      "syntax": {
        "keyword": "#9b2c74",
        "string": "#3d7a1a",
        "comment": "{colors.foreground.subtle}",
        "function": "#6f4400",
        "variable": "#2a2926",
        "number": "#8a5a00",
        "type": "#0e6a85",
        "tag": "#b3261e",
        "attribute": "#8a5a00",
        "property": "#0e6a85",
        "operator": "#57544e"
      }
    },
    "terminal": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "cursor": "{colors.accent.default}",
      "cursorAccent": "{colors.background.root}",
      "selection": "{colors.selection}",
      "ansi": {
        "black": "#1c1b19",
        "red": "#b3261e",
        "green": "#27702b",
        "yellow": "#8f5a00",
        "blue": "#2b5fb4",
        "magenta": "#6b4fd1",
        "cyan": "#0f7b6c",
        "white": "#57544e"
      },
      "ansiBright": {
        "black": "#67645e",
        "red": "#c9372c",
        "green": "#327a36",
        "yellow": "#9a6408",
        "blue": "#3a6cbd",
        "magenta": "#7c5fdc",
        "cyan": "#107f70",
        "white": "#1c1b19"
      }
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.06), 0 4px 16px rgba(0, 0, 0, 0.08)",
      "md": "0 20px 50px rgba(0, 0, 0, 0.16)"
    }
  }
}
