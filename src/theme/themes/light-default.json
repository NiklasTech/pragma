{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",

  "metadata": {
    "id": "light-default",
    "name": "Light Default",
    "author": "Pragma Team",
    "description": "White work surfaces in a soft grey frame with a clear azure accent.",
    "version": "1.1.0",
    "license": "MIT"
  },

  "appearance": {
    "defaultMode": "light",
    "supportedModes": ["light"]
  },

  "tokens": {
    "colors": {
      "background": {
        "chrome": "#e8ecf2",
        "root": "#ffffff",
        "surface": "#f5f7fb",
        "elevated": "#ffffff",
        "input": "#ffffff",
        "hover": "rgba(15, 23, 42, 0.05)",
        "active": "rgba(10, 110, 230, 0.10)",
        "overlay": "rgba(15, 23, 42, 0.35)"
      },
      "foreground": {
        "default": "#1c1f26",
        "muted": "#5a6270",
        "subtle": "#828b99",
        "inverse": "#ffffff"
      },
      "accent": {
        "default": "#0a6ee6",
        "subtle": "rgba(10, 110, 230, 0.10)",
        "glow": "rgba(10, 110, 230, 0.25)"
      },
      "border": {
        "default": "rgba(15, 23, 42, 0.11)",
        "subtle": "rgba(15, 23, 42, 0.07)",
        "focus": "rgba(10, 110, 230, 0.45)"
      },
      "status": {
        "success": "#1f9d6e",
        "successBg": "rgba(31, 157, 110, 0.10)",
        "warning": "#c28a1f",
        "warningBg": "rgba(194, 138, 31, 0.10)",
        "error": "#d6455a",
        "errorBg": "rgba(214, 69, 90, 0.10)",
        "info": "#3b7fe0",
        "infoBg": "rgba(59, 127, 224, 0.10)"
      },
      "git": {
        "added": "{colors.status.success}",
        "addedBg": "{colors.status.successBg}",
        "modified": "{colors.status.warning}",
        "modifiedBg": "{colors.status.warningBg}",
        "deleted": "{colors.status.error}",
        "deletedBg": "{colors.status.errorBg}",
        "untracked": "{colors.status.info}",
        "untrackedBg": "{colors.status.infoBg}",
        "ignored": "{colors.foreground.subtle}",
        "conflict": "#7c5cd6"
      },
      "thread": {
        "default": "{colors.accent.subtle}",
        "active": "{colors.accent.default}"
      },
      "selection": "rgba(10, 110, 230, 0.16)",
      "scrollbar": {
        "track": "transparent",
        "thumb": "rgba(15, 23, 42, 0.14)",
        "thumbHover": "rgba(15, 23, 42, 0.24)"
      }
    },

    "editor": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "selection": "{colors.selection}",
      "cursor": "{colors.accent.default}",
      "gutter": {
        "background": "{colors.background.root}",
        "foreground": "{colors.foreground.subtle}",
        "activeBackground": "{colors.background.surface}"
      },
      "line": {
        "active": "rgba(15, 23, 42, 0.025)",
        "highlight": "rgba(10, 110, 230, 0.05)"
      },
      "syntax": {
        "keyword": "#7c5cd6",
        "string": "#1f8a55",
        "comment": "{colors.foreground.subtle}",
        "function": "#3b6fd4",
        "variable": "#1e40af",
        "number": "#c2600c",
        "type": "#2b6cb0",
        "tag": "{colors.status.error}",
        "attribute": "{colors.accent.default}",
        "property": "#0f766e",
        "operator": "#6d28d9"
      }
    },

    "terminal": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "cursor": "{colors.accent.default}",
      "cursorAccent": "{colors.accent.default}",
      "selection": "{colors.selection}",
      "ansi": {
        "black": "#1c1f26",
        "red": "#d6455a",
        "green": "#1f9d6e",
        "yellow": "#c28a1f",
        "blue": "#0a6ee6",
        "magenta": "#7c5cd6",
        "cyan": "#0e8fa3",
        "white": "#5a6270"
      },
      "ansiBright": {
        "black": "#4a5160",
        "red": "#e35d6a",
        "green": "#3fb68b",
        "yellow": "#e0a94e",
        "blue": "#6e7bf2",
        "magenta": "#a78bfa",
        "cyan": "#22b8cf",
        "white": "#1c1f26"
      }
    },

    "shadows": {
      "sm": "0 4px 16px rgba(15, 23, 42, 0.10)",
      "md": "0 12px 40px rgba(15, 23, 42, 0.18)"
    }
  }
}
