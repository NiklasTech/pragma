{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",
  "metadata": {
    "id": "one-dark",
    "name": "One Dark",
    "author": "GitHub Inc.",
    "description": "Atom's iconic dark theme with muted slate surfaces and a calm blue accent.",
    "version": "1.0.0",
    "license": "MIT",
    "homepage": "https://github.com/atom/atom/tree/master/packages/one-dark-syntax"
  },
  "palette": {
    "background": "#282c34",
    "foreground": "#abb2bf",
    "accent": "#61afef",
    "success": "#98c379",
    "warning": "#e5c07b",
    "error": "#e06c75",
    "info": "#61afef"
  },
  "tokens": {
    "editor": {
      "syntax": {
        "keyword": "#c678dd",
        "string": "#98c379",
        "comment": "{colors.foreground.subtle}",
        "function": "#61afef",
        "variable": "#e2737c",
        "number": "#d19a66",
        "type": "#e5c07b",
        "tag": "{colors.status.error}",
        "attribute": "#d19a66",
        "property": "#e2737c",
        "operator": "#56b6c2"
      }
    }
  }
}
