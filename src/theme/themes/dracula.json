{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",
  "metadata": {
    "id": "dracula",
    "name": "Dracula",
    "author": "Zeno Rocha",
    "description": "A dark theme with vivid purple, pink and green on deep violet-gray.",
    "version": "1.0.0",
    "license": "MIT",
    "homepage": "https://draculatheme.com"
  },
  "palette": {
    "background": "#282a36",
    "foreground": "#f8f8f2",
    "accent": "#bd93f9",
    "success": "#50fa7b",
    "warning": "#ffb86c",
    "error": "#ff5555",
    "info": "#8be9fd"
  },
  "tokens": {
    "editor": {
      "syntax": {
        "keyword": "#ff79c6",
        "string": "#f1fa8c",
        "comment": "{colors.foreground.subtle}",
        "function": "#50fa7b",
        "variable": "#f8f8f2",
        "number": "#bd93f9",
        "type": "#8be9fd",
        "tag": "{colors.status.error}",
        "attribute": "#50fa7b",
        "property": "#8be9fd",
        "operator": "#ff79c6"
      }
    }
  }
}
