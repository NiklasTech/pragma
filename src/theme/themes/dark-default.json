{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",

  "metadata": {
    "id": "dark-default",
    "name": "Dark Default",
    "author": "Pragma Team",
    "description": "Ink-dark surfaces in a deep frame, signed with the Pragma blue-to-cyan gradient.",
    "version": "3.0.0",
    "license": "MIT"
  },

  "appearance": {
    "defaultMode": "dark",
    "supportedModes": ["dark"],
    "preferredEditorTheme": "dark-default"
  },

  "tokens": {
    "colors": {
      "background": {
        "chrome": "#06080c",
        "root": "#0d1016",
        "surface": "#131720",
        "elevated": "#191e29",
        "input": "#151922",
        "hover": "rgba(160, 185, 255, 0.06)",
        "active": "rgba(47, 155, 255, 0.14)",
        "overlay": "rgba(2, 4, 10, 0.62)"
      },
      "foreground": {
        "default": "#e7ecf5",
        "muted": "#9ca6ba",
        "subtle": "#6c768b",
        "inverse": "#06080c"
      },
      "accent": {
        "default": "#2f9bff",
        "subtle": "rgba(47, 155, 255, 0.14)",
        "glow": "rgba(47, 155, 255, 0.30)"
      },
      "border": {
        "default": "rgba(150, 175, 235, 0.10)",
        "subtle": "rgba(150, 175, 235, 0.065)",
        "focus": "rgba(47, 155, 255, 0.50)"
      },
      "status": {
        "success": "#3fb68b",
        "successBg": "rgba(63, 182, 139, 0.12)",
        "warning": "#e0a94e",
        "warningBg": "rgba(224, 169, 78, 0.12)",
        "error": "#e35d6a",
        "errorBg": "rgba(227, 93, 106, 0.12)",
        "info": "#5b9cf5",
        "infoBg": "rgba(91, 156, 245, 0.12)"
      },
      "git": {
        "added": "{colors.status.success}",
        "addedBg": "{colors.status.successBg}",
        "modified": "{colors.status.warning}",
        "modifiedBg": "{colors.status.warningBg}",
        "deleted": "{colors.status.error}",
        "deletedBg": "{colors.status.errorBg}",
        "untracked": "{colors.status.info}",
        "untrackedBg": "{colors.status.infoBg}",
        "ignored": "{colors.foreground.subtle}",
        "conflict": "#a78bfa"
      },
      "thread": {
        "default": "{colors.accent.subtle}",
        "active": "{colors.accent.default}"
      },
      "selection": "rgba(47, 155, 255, 0.22)",
      "scrollbar": {
        "track": "transparent",
        "thumb": "rgba(160, 185, 255, 0.09)",
        "thumbHover": "rgba(160, 185, 255, 0.18)"
      }
    },

    "editor": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "selection": "{colors.selection}",
      "cursor": "{colors.accent.default}",
      "gutter": {
        "background": "{colors.background.root}",
        "foreground": "{colors.foreground.subtle}",
        "activeBackground": "{colors.background.surface}"
      },
      "line": {
        "active": "rgba(160, 185, 255, 0.035)",
        "highlight": "rgba(47, 155, 255, 0.06)"
      },
      "syntax": {
        "keyword": "#c792ea",
        "string": "#c3e88d",
        "comment": "#6d7690",
        "function": "#82aaff",
        "variable": "#b6d6ff",
        "number": "#f78c6c",
        "type": "#ffcb6b",
        "tag": "#f07178",
        "attribute": "#c3e88d",
        "property": "#f07178",
        "operator": "#89ddff"
      }
    },

    "terminal": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "cursor": "{colors.accent.default}",
      "cursorAccent": "{colors.accent.default}",
      "selection": "{colors.selection}",
      "ansi": {
        "black": "#0b0d10",
        "red": "#e35d6a",
        "green": "#3fb68b",
        "yellow": "#e0a94e",
        "blue": "#2f9bff",
        "magenta": "#a78bfa",
        "cyan": "#4ec9d8",
        "white": "#9ba3af"
      },
      "ansiBright": {
        "black": "#2a2f3a",
        "red": "#ed7f8b",
        "green": "#5fcfa5",
        "yellow": "#edbf72",
        "blue": "#6cb8ff",
        "magenta": "#bba5f9",
        "cyan": "#7adbe7",
        "white": "#e8eaee"
      }
    },

    "layout": {
      "headerHeight": 40,
      "tabHeight": 36,
      "statusbarHeight": 26,
      "breadcrumbHeight": 28,
      "inputbarHeight": 42,
      "sidebarWidth": 260,
      "sidebarCollapsedWidth": 44,
      "sidebarMinWidth": 180,
      "sidebarMaxWidth": 480,
      "panelMinHeight": 160,
      "panelDefaultHeight": 240,
      "rowHeight": 26,
      "padding": {
        "xs": 4,
        "sm": 6,
        "md": 8,
        "lg": 12
      }
    },

    "typography": {
      "ui": {
        "2xs": "11px",
        "xs": "12px",
        "sm": "13px",
        "base": "13px",
        "md": "14px",
        "lg": "17px"
      },
      "editor": "14px",
      "lineHeight": {
        "ui": {
          "2xs": "14px",
          "xs": "16px",
          "sm": "18px",
          "base": "20px",
          "md": "22px",
          "lg": "24px"
        },
        "editor": "22px"
      }
    },

    "motion": {
      "duration": {
        "fast": "150ms",
        "base": "200ms",
        "slow": "250ms",
        "layout": "300ms"
      },
      "ease": {
        "default": "cubic-bezier(0.4, 0, 0.2, 1)",
        "out": "cubic-bezier(0.16, 1, 0.3, 1)",
        "inOut": "cubic-bezier(0.2, 0, 0, 1)",
        "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },

    "shadows": {
      "sm": "0 4px 16px rgba(0, 0, 0, 0.28)",
      "md": "0 12px 40px rgba(0, 0, 0, 0.45)"
    }
  }
}
