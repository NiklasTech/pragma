{
  "$schema": "https://pragma.dev/theme-schema/v1.json",
  "format": "pragma-theme-v1",
  "metadata": {
    "id": "dark-default",
    "name": "Pragma Dark",
    "author": "Pragma Team",
    "description": "Calm graphite ground with darker wells for panes; Pragma orange marks what needs you.",
    "version": "4.0.0",
    "license": "MIT"
  },
  "appearance": {
    "defaultMode": "dark",
    "supportedModes": ["dark"]
  },
  "tokens": {
    "colors": {
      "background": {
        "chrome": "#141517",
        "root": "#0c0d0f",
        "surface": "#131417",
        "elevated": "#1a1b1f",
        "input": "#111214",
        "hover": "rgba(255, 255, 255, 0.05)",
        "active": "rgba(255, 255, 255, 0.08)",
        "overlay": "rgba(6, 6, 8, 0.6)"
      },
      "foreground": {
        "default": "#ecebe7",
        "muted": "#a6a39c",
        "subtle": "#8f8c85",
        "inverse": "#141517"
      },
      "accent": {
        "default": "#ff7a3d",
        "subtle": "rgba(255, 122, 61, 0.14)",
        "glow": "rgba(255, 122, 61, 0.3)"
      },
      "border": {
        "default": "rgba(255, 255, 255, 0.08)",
        "subtle": "rgba(255, 255, 255, 0.055)",
        "focus": "rgba(255, 122, 61, 0.6)"
      },
      "status": {
        "success": "#86c98a",
        "successBg": "rgba(134, 201, 138, 0.12)",
        "warning": "#e5b77f",
        "warningBg": "rgba(229, 183, 127, 0.12)",
        "error": "#e88f87",
        "errorBg": "rgba(232, 143, 135, 0.12)",
        "info": "#8fb3ef",
        "infoBg": "rgba(143, 179, 239, 0.12)"
      },
      "git": {
        "added": "{colors.status.success}",
        "addedBg": "{colors.status.successBg}",
        "modified": "{colors.status.warning}",
        "modifiedBg": "{colors.status.warningBg}",
        "deleted": "{colors.status.error}",
        "deletedBg": "{colors.status.errorBg}",
        "untracked": "{colors.status.info}",
        "untrackedBg": "{colors.status.infoBg}",
        "ignored": "{colors.foreground.subtle}",
        "conflict": "#b9a3f5"
      },
      "thread": {
        "default": "{colors.accent.subtle}",
        "active": "{colors.accent.default}"
      },
      "selection": "rgba(143, 179, 239, 0.22)",
      "scrollbar": {
        "track": "transparent",
        "thumb": "rgba(255, 255, 255, 0.08)",
        "thumbHover": "rgba(255, 255, 255, 0.16)"
      }
    },
    "editor": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "selection": "{colors.selection}",
      "cursor": "{colors.accent.default}",
      "gutter": {
        "background": "{colors.background.root}",
        "foreground": "{colors.foreground.subtle}",
        "activeBackground": "{colors.background.surface}"
      },
      "line": {
        "active": "rgba(255, 255, 255, 0.035)",
        "highlight": "rgba(143, 179, 239, 0.08)"
      },
      "syntax": {
        "keyword": "#d39fc4",
        "string": "#b4cf91",
        "comment": "{colors.foreground.subtle}",
        "function": "#ebe5d4",
        "variable": "#d4d1ca",
        "number": "#e5b77f",
        "type": "#8fc3d6",
        "tag": "#e88f87",
        "attribute": "#e5b77f",
        "property": "#8fc3d6",
        "operator": "#a6a39c"
      }
    },
    "terminal": {
      "background": "{colors.background.root}",
      "foreground": "{colors.foreground.default}",
      "cursor": "{colors.accent.default}",
      "cursorAccent": "{colors.background.root}",
      "selection": "{colors.selection}",
      "ansi": {
        "black": "#2a2b30",
        "red": "#e88f87",
        "green": "#86c98a",
        "yellow": "#e5b77f",
        "blue": "#8fb3ef",
        "magenta": "#b9a3f5",
        "cyan": "#6cc7b5",
        "white": "#bdbab3"
      },
      "ansiBright": {
        "black": "#77746d",
        "red": "#f0aaa3",
        "green": "#a3d8a6",
        "yellow": "#efcc9f",
        "blue": "#adc8f4",
        "magenta": "#cdbcf8",
        "cyan": "#8fd8c9",
        "white": "#ecebe7"
      }
    },
    "shadows": {
      "sm": "0 4px 16px rgba(0, 0, 0, 0.35)",
      "md": "0 24px 64px rgba(0, 0, 0, 0.55)"
    }
  }
}
